{
  "name": "@tenderpilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=../../.env --env-file-if-exists=../../docker/.env.local src/server.js",
    "start": "node src/server.js",
    "worker": "node --watch --env-file=../../.env --env-file-if-exists=../../docker/.env.local src/worker.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env --env-file-if-exists=../../docker/.env.local src/db/migrate.js",
    "db:seed": "node --env-file=../../.env --env-file-if-exists=../../docker/.env.local src/db/seed/index.js",
    "db:index": "node --env-file=../../.env --env-file-if-exists=../../docker/.env.local src/db/reindex.js",
    "db:reset": "node --env-file=../../.env --env-file-if-exists=../../docker/.env.local src/db/seed/reset.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^10.1.1",
    "@langchain/langgraph": "^0.4.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@tenderpilot/shared": "*",
    "bullmq": "^5.58.5",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.0",
    "ioredis": "^5.7.0",
    "openai": "^7.17.0",
    "pino": "^9.9.0",
    "postgres": "^3.4.7",
    "unpdf": "^1.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.6",
    "pino-pretty": "^13.1.1",
    "vitest": "^5.0.1"
  }
}
