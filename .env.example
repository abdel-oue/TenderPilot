# Copy to .env and fill. Never commit .env - a key in the repo is eliminatoire.
# Every new env var introduced anywhere gets added here with an empty value.

# --- web ---
# baked into the client bundle at BUILD time (docker build arg), not only runtime
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- api ---
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3100
# fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# --- auth ---
# HS256 signing key for the session JWT: openssl rand -hex 32
JWT_SECRET=

# --- postgres ---
# compose builds the container-side URL from the three vars below; this one is
# what you use locally (drizzle-kit, psql) against the published 5432.
DATABASE_URL=postgres://tenderpilot:tenderpilot@localhost:5432/tenderpilot
POSTGRES_USER=tenderpilot
POSTGRES_PASSWORD=tenderpilot
POSTGRES_DB=tenderpilot

# --- redis ---
REDIS_URL=redis://localhost:6379

# --- llm: tier "reasoning" (gpt-5.5) -------------------------------------
# Orchestration, multi-step decisions, the go/no-go verdict. Expensive: use it
# only where reasoning actually decides something.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.5

# --- embeddings (same endpoint as the reasoning tier) --------------------
# Computed once and stored. Never re-indexed per request.
EMBEDDING_MODEL=embedder-small-3
EMBEDDING_DIMENSIONS=512

# --- llm: tier "volume" (gpt-4.1) ----------------------------------------
# Extraction, classification, drafting, JSON formatting, repeated tool calls.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_MAX_TOKENS=16384

# --- ocr ---
# tesseract language pack. The dossiers are French.
OCR_LANG=fra

# --- flags ---
# 1 = stub both LLM providers at the service boundary (E2E runs, default CI)
STUB_LLM=
