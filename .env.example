# Copy to .env and fill. Never commit .env.
# Every new env var introduced anywhere gets added here with an empty value.

# --- web ---
# baked at build time by docker/web.Dockerfile, not only runtime
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- api ---
PORT=3000
NODE_ENV=
WEB_ORIGIN=http://localhost:3100

# --- auth ---
# HS256 signing key for the session JWT: openssl rand -hex 32
JWT_SECRET=

# --- postgres ---
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- redis ---
REDIS_URL=

# --- llm ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- ocr ---
OCR_LANG=

# --- flags ---
# 1 = stub the LLM at the api boundary (E2E runs, default CI)
STUB_LLM=
