# Copy to .env and fill. Never commit .env.
# Every new env var introduced anywhere gets added here with an empty value.

# --- web ---
NEXT_PUBLIC_API_URL=

# --- api ---
PORT=
NODE_ENV=
WEB_ORIGIN=

# --- postgres ---
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- redis ---
REDIS_URL=

# --- llm ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- ocr ---
OCR_LANG=

# --- flags ---
# 1 = stub the LLM at the api boundary (E2E runs, default CI)
STUB_LLM=
