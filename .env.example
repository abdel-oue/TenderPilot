# Copie ce fichier en .env. Les valeurs ci-dessous marchent telles quelles :
# seules les cles modele (LLM_*, AZURE_OPENAI_*) sont a remplir.
# .env est gitignore - une cle commitee est eliminatoire.

# --- ports publies (127.0.0.1 uniquement) --------------------------------
# Meme numero dans le conteneur et sur l'hote. A changer si la machine utilise
# deja ces ports :  ss -tlnp | grep -E ':(4000|4100|5433)\b'
API_HOST_PORT=4000
WEB_HOST_PORT=4100
POSTGRES_HOST_PORT=5433

# --- web ------------------------------------------------------------------
# Cuit dans le bundle client au BUILD, pas au runtime : c'est l'URL que le
# NAVIGATEUR appelle. La changer => rebuild. En production elle est definie
# dans le projet Vercel, pas ici.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- api ------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Origine exacte du web : schema + hote + port, sans slash final. Envoyee
# telle quelle en Access-Control-Allow-Origin, donc un ecart = tout casse.
WEB_ORIGIN=http://localhost:4100
# silent|fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# --- auth -----------------------------------------------------------------
# Cle de signature des sessions (HS256). Celle-ci suffit en local.
# RECOMMANDE de la regenerer, et OBLIGATOIRE sur un serveur public :
#   openssl rand -hex 32
JWT_SECRET=tenderpilot123

# --- postgres -------------------------------------------------------------
# DATABASE_URL est la vue HOTE (psql, drizzle-kit) sur le port publie ; compose
# reconstruit la vue conteneur (@postgres:5432) de son cote.
# Le mot de passe ci-dessous convient en local : le port n'ecoute que sur
# 127.0.0.1. RECOMMANDE de le changer, et obligatoire sur un serveur.
# Postgres ne l'applique qu'en creant un volume VIDE - le changer ensuite
# demande le ALTER USER de docs/deployment.md.
DATABASE_URL=postgres://tenderpilot:tenderpilot123@localhost:5433/tenderpilot
POSTGRES_USER=tenderpilot
POSTGRES_PASSWORD=tenderpilot123
POSTGRES_DB=tenderpilot

# --- redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- llm : tier "raisonnement" (gpt-5.5) --- A REMPLIR --------------------
# Orchestration, decisions multi-etapes, le verdict go/no-go.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.5

# --- embeddings (meme endpoint que le tier raisonnement) ------------------
# 512 exactement : la colonne vector(512) est figee dans la DDL.
EMBEDDING_MODEL=embedder-small-3
EMBEDDING_DIMENSIONS=512

# --- llm : tier "volume" (gpt-4.1) --- A REMPLIR --------------------------
# Extraction, classification, redaction, formatage JSON.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_MAX_TOKENS=16384

# --- outils ---------------------------------------------------------------
# OPTIONNEL. Absente = l'agent n'a pas d'outil web_search ; rien ne casse.
TAVILY_API_KEY=

# --- ocr ------------------------------------------------------------------
# Packs tesseract joints par '+'. Les deux sont dans l'image api.
OCR_LANG=fra+eng

# --- uploads --------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# --- flags ----------------------------------------------------------------
# 1 = stub des deux fournisseurs LLM (E2E, CI). Vide en usage normal.
STUB_LLM=
