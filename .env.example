# Copy to .env and fill. Never commit .env - a key in the repo is eliminatoire.
# Every new env var introduced anywhere gets added here with an empty value.

# --- published host ports -------------------------------------------------
# The container-side ports never move (api 3000, web 3100, postgres 5432): only
# the host side is published, and only on 127.0.0.1. Set these when the machine
# already runs something on the defaults - on a shared VPS it usually does.
# Check before choosing:  ss -tlnp | grep -E ':(4000|4100|5433)\b'
# WEB_HOST_PORT is local-only: in production the web is on Vercel, and
# `npm run up:vps` does not start the web container at all.
API_HOST_PORT=4000
WEB_HOST_PORT=4100
POSTGRES_HOST_PORT=5433

# --- web ---
# baked into the client bundle at BUILD time, not runtime. It is the URL the
# BROWSER uses, so behind a reverse proxy it is the public hostname, never the
# container port. Change it => rebuild.
# In production the web is on Vercel, so this is set in the VERCEL project
# (= https://api.tenderpilot.ouedghiri.dev) and this value only drives the
# local full-stack `npm run up`.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- api ---
PORT=3000
NODE_ENV=development
# Exact origin of the web app: scheme + host + port, no trailing slash. It is
# sent verbatim as Access-Control-Allow-Origin, so a mismatch = every call fails.
WEB_ORIGIN=http://localhost:4100
# silent|fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# --- auth ---
# HS256 signing key for the session JWT: openssl rand -hex 32
JWT_SECRET=

# --- postgres ---
# compose builds the container-side URL from the three vars below; this one is
# what you use locally (drizzle-kit, psql) against the published POSTGRES_HOST_PORT.
DATABASE_URL=postgres://tenderpilot:tenderpilot@localhost:5433/tenderpilot
POSTGRES_USER=tenderpilot
POSTGRES_PASSWORD=tenderpilot
POSTGRES_DB=tenderpilot

# --- redis ---
REDIS_URL=redis://localhost:6379

# --- llm: tier "reasoning" (gpt-5.5) -------------------------------------
# Orchestration, multi-step decisions, the go/no-go verdict. Expensive: use it
# only where reasoning actually decides something.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.5

# --- embeddings (same endpoint as the reasoning tier) --------------------
# Computed once and stored. Never re-indexed per request.
EMBEDDING_MODEL=embedder-small-3
EMBEDDING_DIMENSIONS=512

# --- llm: tier "volume" (gpt-4.1) ----------------------------------------
# Extraction, classification, drafting, JSON formatting, repeated tool calls.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_MAX_TOKENS=16384

# --- tools ---
# OPTIONAL. Without it the agent simply has no web_search tool; nothing breaks.
# Used for the "comparer avec les derniers marches attribues" bonus.
TAVILY_API_KEY=

# --- ocr ---
# tesseract language pack. The dossiers are French.
# Where uploaded PDFs are stored. Relative to the repo root; a named docker
# volume is mounted here in compose so uploads survive a container rebuild.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

OCR_LANG=fra

# --- flags ---
# 1 = stub both LLM providers at the service boundary (E2E runs, default CI)
STUB_LLM=
