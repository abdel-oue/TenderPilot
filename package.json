{
  "name": "tenderpilot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @tenderpilot/web",
    "dev:api": "npm run dev -w @tenderpilot/api",
    "dev:worker": "npm run worker -w @tenderpilot/api",
    "build": "npm run build -w @tenderpilot/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @tenderpilot/web",
    "db:generate": "npm run db:generate -w @tenderpilot/api",
    "db:migrate": "npm run db:migrate -w @tenderpilot/api",
    "db:seed": "npm run db:seed -w @tenderpilot/api",
    "db:index": "npm run db:index -w @tenderpilot/api",
    "db:reset": "npm run db:reset -w @tenderpilot/api",
    "up": "docker compose up -d --build",
    "up:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f api worker"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
